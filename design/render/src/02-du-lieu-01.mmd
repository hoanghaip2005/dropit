  users { uuid id PK
    text cognito_sub UK
    user_status status
    int current_streak "KCN"
    int longest_streak "KCN" }
  groups { uuid id PK
    uuid owner_id FK
    group_status status
    text report_purpose
    int consent_version
    char invite_code UK }
  group_members { uuid id PK
    uuid group_id FK
    uuid user_id FK "UK khi left_at null"
    int consent_version
    timestamptz left_at }
  sessions { uuid id PK
    uuid group_id FK
    smallint duration_min "25|50"
    session_status status
    timestamptz started_at
    timestamptz ends_at
    bool forfeited
    uuid forfeit_trigger_user_id FK }
  session_members { uuid session_id PK
    uuid user_id PK
    member_state state
    int focus_seconds
    bool exempted }
  coin_ledger { uuid entry_id PK
    ledger_type type
    int amount
    uuid ref_id
    date reward_date
    text idempotency_key UK }
  appeals { uuid id PK
    appeal_status status }
  journals { uuid id PK
    bytea ciphertext "mã hóa" }
