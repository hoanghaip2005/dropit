dropit.tutty-lab-demo.com {
 encode zstd gzip
 @backend path /v1/* /socket.io/* /health
 handle @backend {
  reverse_proxy 127.0.0.1:3000
 }
 handle {
  root * /opt/dropit/web
  try_files {path} /index.html
  file_server
 }
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  -Server
 }
}
