NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://dropit:dropit@127.0.0.1:55433/dropit
JWT_SECRET=dev-only-secret-change-me
# Tham số engine (ms). Mặc định theo system_params.
GRACE_MS=3000
COUNTDOWN_MS=5000
HB_TIMEOUT_MS=10000
HOLD_MS=10000
LOBBY_OPEN_MS=600000
OPEN_SESSIONS_INTERVAL_MS=30000
# Chỉ có hiệu lực khi NODE_ENV=test:
# SESSION_MINUTE_MS=100        # 1 "phút" phiên = 100 ms
# SCHEDULE_MIN_LEAD_MS=0       # bỏ khoảng tối thiểu đặt lịch (BR-79)
# Nhật ký: khóa chủ bọc khóa dữ liệu (base64 32 byte hoặc chuỗi bất kỳ → SHA-256). Thay KMS ở bản AWS.
JOURNAL_MASTER_KEY=dev-only-journal-key-change-me
# Avatar lưu local (thay S3) và email báo cáo ghi ra tệp (không gửi thật)
UPLOADS_DIR=./uploads
OUTBOX_DIR=./outbox
PUBLIC_BASE_URL=http://localhost:3000
# 0 = tắt chạy bù báo cáo tháng trong cron
MONTHLY_REPORT_CRON=1
